# Copia este archivo como .env SOLO en desarrollo. En el servidor los secretos van en el
# Administrador de credenciales de Windows (ver docs/despliegue-windows.md).
ENTORNO=dev
DATABASE_URL=sqlite:///./dev/oleoweb.db
# Mismo valor que API_TOKEN_SECRET en web/.env.local. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN_SECRET=
