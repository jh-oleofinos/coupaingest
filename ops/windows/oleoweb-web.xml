<!-- WinSW: renombra WinSW-x64.exe a oleoweb-web.exe junto a este archivo y ejecuta: oleoweb-web.exe install -->
<service>
  <id>oleoweb-web</id>
  <name>Portal Oleofinos - Web</name>
  <description>Portal Oleofinos (Next.js, HTTPS).</description>
  <executable>powershell.exe</executable>
  <arguments>-NoProfile -ExecutionPolicy Bypass -File "C:\oleoweb\ops\windows\iniciar-web.ps1"</arguments>
  <serviceaccount>
    <username>DOMINIO\svc_oleoweb_web</username>
    <allowservicelogon>true</allowservicelogon>
    <!-- La contraseña se captura al instalar (oleoweb-web.exe install /p), nunca aquí. -->
  </serviceaccount>
  <startmode>Automatic</startmode>
  <depend>oleoweb-api</depend>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>10</keepFiles></log>
  <logpath>C:\oleoweb\logs</logpath>
</service>
